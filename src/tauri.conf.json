{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NAI OS",
  "identifier": "com.seelen.seelen-ui",
  "version": "../package.json",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**/*",
          "$TEMP/**/*",
          "$APPDATA/**/*",
          "$LOCALDATA/**/*",
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.png",
          "**/*.webp",
          "**/*.gif",
          "**/*.svg"
        ]
      }
    },
    "withGlobalTauri": false
  },
  "build": {
    "beforeDevCommand": "npm run build:ui -- --serve",
    "beforeBuildCommand": "npm run build:ui -- --production",
    "devUrl": "http://localhost:3579/",
    "frontendDist": "../dist",
    "features": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "NAI",
    "category": "Utility",
    "copyright": "Copyright \u00c2\u00a9 2024",
    "shortDescription": "NAI OS",
    "longDescription": "NAI OS \u00e2\u20ac\u201d semantic desktop environment for Windows",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/eythaann/Seelen-UI",
    "resources": {
      "static": "static"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "static/icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "static/icons/icon.ico",
        "sidebarImage": "static/icons/banner.bmp",
        "template": "templates/installer.nsi",
        "installerHooks": "templates/installer-hooks.nsh",
        "installMode": "perMachine",
        "startMenuFolder": "NAI",
        "displayLanguageSelector": true,
        "languages": [
          "arabic",
          "bulgarian",
          "dutch",
          "english",
          "french",
          "german",
          "japanese",
          "korean",
          "portuguesebr",
          "russian",
          "simpchinese",
          "spanish",
          "swedish",
          "tradchinese",
          "turkish"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          ".slu"
        ],
        "name": "seelen-ui.file",
        "description": "NAI OS File",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERTQwQzVEMkUwNjQ2NDQKUldSRVJnWXVYUXprUGJlZFlNTEJDWWExQ2Fuc2VRVFpLcm9lQjRKdHdIeDB6aXdGTElhTkVyWHIK"
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "seelen-ui"
        ]
      }
    }
  }
}
